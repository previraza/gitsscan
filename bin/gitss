#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -z "${GITSS_ROOT:-}" ]]; then
  # Dev mode: repo layout.
  if [[ -d "$SCRIPT_DIR/../lib" ]]; then
    GITSS_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
  # Installed mode: libs live in /usr/local/lib/gitss by default.
  elif [[ -d "/usr/local/lib/gitss/lib" ]]; then
    GITSS_ROOT="/usr/local/lib/gitss"
  else
    printf 'Error: cannot locate GitSScan lib directory. Reinstall with install.sh.\n' >&2
    exit 1
  fi
fi

# shellcheck source=lib/core.sh
source "$GITSS_ROOT/lib/core.sh"
# shellcheck source=lib/cli.sh
source "$GITSS_ROOT/lib/cli.sh"
# shellcheck source=lib/scanner.sh
source "$GITSS_ROOT/lib/scanner.sh"
# shellcheck source=lib/git_ops.sh
source "$GITSS_ROOT/lib/git_ops.sh"
# shellcheck source=lib/output.sh
source "$GITSS_ROOT/lib/output.sh"

main "$@"
